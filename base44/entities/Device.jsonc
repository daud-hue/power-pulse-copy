{
  "name": "Device",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Device name e.g. Geyser"
    },
    "icon": {
      "type": "string",
      "description": "Lucide icon name"
    },
    "kwh_per_hour": {
      "type": "number",
      "description": "Estimated power draw in kWh per hour"
    },
    "is_on": {
      "type": "boolean",
      "default": false,
      "description": "Whether the device is currently active"
    },
    "category": {
      "type": "string",
      "enum": [
        "heating",
        "cooling",
        "lighting",
        "appliances",
        "entertainment",
        "kitchen",
        "other"
      ],
      "default": "appliances"
    },
    "daily_hours": {
      "type": "number",
      "default": 1,
      "description": "Estimated hours the device runs per day, used for cost breakdown"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order in the device list (lower first)"
    }
  },
  "required": [
    "name",
    "kwh_per_hour"
  ]
}