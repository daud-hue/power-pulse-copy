{
  "name": "AppNotification",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "high_usage",
        "log_reminder"
      ],
      "description": "Type of notification"
    },
    "title": {
      "type": "string",
      "description": "Short title for the toast"
    },
    "message": {
      "type": "string",
      "description": "Detailed message body"
    },
    "dismissed": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user has dismissed this notification"
    },
    "user_id": {
      "type": "string",
      "description": "Target user ID for this notification"
    }
  },
  "required": [
    "type",
    "title",
    "message",
    "user_id"
  ]
}